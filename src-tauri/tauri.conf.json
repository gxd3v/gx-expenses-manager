{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Expenses Manager",
  "version": "0.7.2",
  "identifier": "com.gxd3v.expenses",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Expenses Manager",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "shadow": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --lang=pt-PT"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "languages": [
          "Portuguese"
        ]
      }
    }
  },
  "mainBinaryName": "expenses-manager",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJERDJDMzNBRURFOTE3OTUKUldTVkYrbnRPc1BTdlJhRW5uV0JPUkpkeU9qWjMyekZROVlXTDZvNHEvRGN5NGZydGxWeW50aGkK",
      "endpoints": [
        "https://github.com/gxd3v/gx-expenses-manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
